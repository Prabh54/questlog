generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum QuestStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
  LEGENDARY
}

enum QuestFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      UserRole @default(USER)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories Category[]
  quests     Quest[]
  entries    QuestEntry[]
  sessions   Session[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests Quest[]

  @@unique([name, userId])
  @@index([userId])
  @@map("categories")
}

model Quest {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      QuestStatus     @default(ACTIVE)
  difficulty  QuestDifficulty @default(MEDIUM)
  frequency   QuestFrequency  @default(DAILY)
  xpReward    Int             @default(10) @map("xp_reward")
  dueDate     DateTime?       @map("due_date")
  completedAt DateTime?       @map("completed_at")
  userId      String          @map("user_id")
  categoryId  String?         @map("category_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries  QuestEntry[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([userId, status])
  @@index([dueDate])
  @@map("quests")
}

model QuestEntry {
  id          String   @id @default(cuid())
  questId     String   @map("quest_id")
  userId      String   @map("user_id")
  xpEarned    Int      @map("xp_earned")
  note        String?
  // Completion bucket (see periodKey in src/utils/dates.ts); one entry per bucket
  periodKey   String   @map("period_key")
  completedAt DateTime @default(now()) @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, periodKey])
  @@index([questId])
  @@index([questId, completedAt])
  @@index([userId, completedAt(sort: Desc)])
  @@map("quest_entries")
}

// ── Auth sessions ───────────────────────────────────────────────────────────
// A Session is one login on one device: a family of rotating refresh tokens.
// Logout, "log out everywhere" and refresh-token reuse all revoke the session,
// which invalidates every token in the family.
model Session {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  // Absolute lifetime: rotation never extends a session past this
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  // LOGOUT | LOGOUT_ALL | REUSE_DETECTED
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

// Only a SHA-256 hash of each refresh token is stored. A token is single-use:
// presenting one whose usedAt is set means it was stolen or replayed.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  tokenHash String    @unique @map("token_hash")
  // Idle timeout: the session dies if not refreshed before this
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}
