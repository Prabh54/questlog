# Rendered by the nginx image's entrypoint (envsubst) from:
#   API_UPSTREAM  e.g. https://questlog-api-snowy-seastar-7669.fly.dev
#   PROXY_SECRET  shared with the API; lets it trust X-Client-IP for rate limiting

# Visitor IP: Fly's edge sets Fly-Client-IP; fall back to the TCP peer locally
map $http_fly_client_ip $visitor_ip {
    ""      $remote_addr;
    default $http_fly_client_ip;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: /api/quests → ${API_UPSTREAM}/quests. Keeping the API on
    # this origin makes the refresh cookie first-party and SameSite=Strict.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;

        # Overwrite anything the client sent under these names
        proxy_set_header X-Client-IP $visitor_ip;
        proxy_set_header X-Proxy-Auth "${PROXY_SECRET}";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Fly-Client-IP "";

        client_max_body_size 32k;
        proxy_read_timeout 30s;
    }

    # App shell. (API responses keep the API's own helmet headers.)
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
}
